    %% ── Request flow ──────────────────────────────────────
    USER -->|"POST /chat + Bearer JWT"| CALB
    CALB --> CHAT
    CHAT -.->|"validate JWT"| COG
    AGENT -.->|"validate JWT"| COG

    CHAT -->|"POST /invoke\n+ Bearer token"| AALB
    AALB --> AGENT

    %% ── Agent startup ─────────────────────────────────────
    AGENT -.->|"startup · read config\n(ECS execution role)"| SSM_PS
    AGENT -.->|"startup · connect MCP\n+ list_tools_sync()"| MALB
    MALB -.-> MCP

    %% ── Per-request agent tool calls ──────────────────────
    AGENT -->|"search_and_load_skill\nSearchRegistryRecords\nIAM SigV4 · task role"| REGISTRY
    REGISTRY -->|"SKILL.md content"| AGENT

    AGENT -->|"download skill artifacts\nIAM SigV4 · task role"| S3

    AGENT <-->|"converse_stream\nIAM SigV4 · task role"| BED

    AGENT -->|"MCP tool calls\nstreamable-HTTP + SigV4"| MALB
    MALB --> MCP
    MCP -->|"financial data\nKPI benchmarks"| AGENT

